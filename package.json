{
  "name": "SmartSakay",
  "version": "1.0.0",
  "private": true,
  "description": "SmartSakay - A Commuter Application for Routing and Fare Matrix",
  "workspaces": [
    "backend",
    "frontend/admin",
    "frontend/mobile"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm --workspace backend run dev",
    "dev:admin": "npm --workspace frontend/admin run dev",
    "dev:mobile": "npm --workspace frontend/mobile start",
    "dev:mobile:web": "npm --workspace frontend/mobile run web",
    "build": "npm run build:admin",
    "build:admin": "npm --workspace frontend/admin run build",
    "seed": "npm --workspace backend run seed",
    "db:import": "npm --workspace backend run db:import",
    "db:view": "npm --workspace backend run db:view",
    "db:export": "npm --workspace backend run db:export",
    "test:server": "npm --workspace backend test"
  },
  "keywords": [
    "dagupan",
    "commuter",
    "jeepney",
    "fare",
    "ltfrb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "0.468.0"
  }
}
